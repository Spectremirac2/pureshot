{
  "name": "cureshotkick-fan-hub",
  "private": true,
  "version": "1.0.0",
  "description": "CureShotKick resmi olmayan hayran üssü — DOG DOG DOG, 1vDOQUZ, mini oyunlar, quizler, espri duvarı, fal.ai atölyesi.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode artifact && node scripts/build-artifact.mjs",
    "build:static": "vite build",
    "preview": "vite preview",
    "fetch:fal": "node scripts/fetch-fal-assets.mjs",
    "fetch:heroes": "node scripts/fetch-hero-images.mjs",
    "fetch:abilities": "node scripts/fetch-abilities.mjs",
    "fetch:game-icons": "node scripts/fetch-ability-icons.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "build:fonts": "node scripts/subset-fonts.mjs",
    "build:atlas": "node scripts/build-hero-atlas.mjs",
    "build:share": "node scripts/build-share-images.mjs",
    "api:dev": "node --disable-warning=ExperimentalWarning server/local/dev.mjs",
    "test:api": "node --disable-warning=ExperimentalWarning --test server/test/worker.test.mjs",
    "deploy:worker": "npm run build && cd server && npx wrangler deploy"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.5",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "three": "^0.170.0"
  }
}
